{
  "name": "malazgirt-akincilari",
  "version": "1.0.0",
  "private": true,
  "description": "Malazgirt Akıncıları - 1071 temalı kalabalık koşucusu (iOS + Android, Capacitor)",
  "scripts": {
    "serve": "npx http-server . -p 8765 -c-1",
    "sync": "npx cap sync",
    "android": "npx cap open android",
    "ios": "npx cap open ios",
    "ikonlar": "capacitor-assets generate --ios --android --iconBackgroundColor '#1d3f6e' --iconBackgroundColorDark '#1d3f6e' --splashBackgroundColor '#0c1c34' --splashBackgroundColorDark '#0c1c34'",
    "denge": "node araclar/denge-testi.js",
    "kalibre": "node araclar/kalibre.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capgo/native-purchases": "^8.9.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5"
  }
}
